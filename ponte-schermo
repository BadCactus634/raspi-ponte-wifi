#!/bin/bash
# Pagina di stato del ponte sullo schermino 3,5" (console tty1, 48x16 caratteri).
# Lo lancia ponte-schermo.service; si aggiorna ogni 2 secondi.
# Se per SCHERMO_ACCESO_PER secondi non cambia niente (online/offline, WiFi collegato o no,
# numero di dispositivi) lo schermo diventa nero. La retroilluminazione del pannello e'
# collegata fissa all'alimentazione, quindi via software non si spegne: si spengono i pixel.
set -u
WAN=wlan0
LAN=eth0
PASSO=2
STATO_LOGIN=/run/portale-login/stato
NON_CONTARE_MAC=""
SCHERMO_ACCESO_PER=120
[ -f /etc/ponte/schermo.conf ] && . /etc/ponte/schermo.conf

for f in Uni2-TerminusBold20x10 Lat15-TerminusBold20x10 Uni2-Terminus20x10; do
  [ -f /usr/share/consolefonts/$f.psf.gz ] && setfont /usr/share/consolefonts/$f.psf.gz 2>/dev/null && break
done
printf '\e[13]\e[?25l\e[2J'   # console risvegliata, niente cursore, schermo pulito

V=$'\e[32m'; R=$'\e[31m'; G=$'\e[33m'; A=$'\e[36m'; B=$'\e[1m'; N=$'\e[0m'

byte() { cat /sys/class/net/$1/statistics/$2_bytes 2>/dev/null || echo 0; }

# 1234567 byte/s -> "9.9 Mbit/s"
velocita() {
  awk -v b="$1" -v s="$PASSO" 'BEGIN { x = b * 8 / s;
    if (x >= 1e6) printf "%.1f Mbit/s", x / 1e6; else printf "%.0f kbit/s", x / 1e3 }'
}

# byte totali -> "1.2 GB"
quanti() {
  awk -v b="$1" 'BEGIN { if (b >= 1e9) printf "%.1f GB", b / 1e9;
    else if (b >= 1e6) printf "%.0f MB", b / 1e6; else printf "%.0f kB", b / 1e3 }'
}

riga() { printf '%s\e[K\n' "$1"; }

rx0=$(byte $WAN rx); tx0=$(byte $WAN tx)
prima=""        # cosa c'era al giro prima: online/offline, WiFi, dispositivi
acceso_fino=$((SECONDS + SCHERMO_ACCESO_PER))
nero=0
while true; do
  sleep $PASSO
  rx1=$(byte $WAN rx); tx1=$(byte $WAN tx)
  giu=$(velocita $((rx1 - rx0))); su=$(velocita $((tx1 - tx0)))
  rx0=$rx1; tx0=$tx1

  # WiFi
  ssid=$(iw dev $WAN link 2>/dev/null | sed -n 's/^\s*SSID: //p')
  dbm=$(iw dev $WAN link 2>/dev/null | sed -n 's/^\s*signal: \(-[0-9]*\).*/\1/p')
  ipwan=$(ip -4 -o addr show $WAN 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
  if [ -n "$ssid" ]; then
    q=$(( (${dbm:--100} + 100) * 2 )); [ $q -gt 100 ] && q=100; [ $q -lt 0 ] && q=0
    col=$V; [ $q -lt 50 ] && col=$G; [ $q -lt 25 ] && col=$R
    wifi="${col}${ssid:0:16} ${dbm} dBm ${q}%${N}"
  else
    wifi="${R}non collegato${N}"
  fi

  # Internet e login sul portale (lo stato lo scrive portale-login)
  stato=$(cat $STATO_LOGIN 2>/dev/null || echo "in attesa")
  case "$stato" in
    online*) inet="${V}${B}ONLINE${N} ${stato#online}"; in_rete=online ;;
    *)       inet="${R}${B}OFFLINE${N} $stato"; in_rete=offline ;;
  esac

  # LAN: dispositivi presenti sullo switch. Le voci STALE il kernel non le butta mai
  # (sotto gc_thresh1), quindi un dispositivo andato via resterebbe contato per sempre:
  # un ping fa partire la verifica ARP, e chi non risponde passa a FAILED in pochi secondi.
  # Solo IPv4, se no un dispositivo con anche l'IPv6 conta due o tre volte.
  for ip in $(ip -4 neigh show dev $LAN nud stale 2>/dev/null | cut -d' ' -f1); do
    ping -c1 -W1 -I $LAN "$ip" >/dev/null 2>&1 &
  done
  # Lo switch gestito prende un indirizzo ma non e' un dispositivo: NON_CONTARE_MAC.
  disp=$(ip -4 neigh show dev $LAN 2>/dev/null | awk -v no="${NON_CONTARE_MAC,,}" '
    BEGIN { n = split(no, l, " "); for (i = 1; i <= n; i++) salta[l[i]] = 1 }
    /REACHABLE|STALE|DELAY|PROBE/ && !(tolower($3) in salta) { c++ } END { print c + 0 }')
  link=$(cat /sys/class/net/$LAN/carrier 2>/dev/null)
  if [ "$link" = 1 ]; then
    lan="${V}$(cat /sys/class/net/$LAN/speed 2>/dev/null) Mbit${N}"
  else
    lan="${R}cavo scollegato${N}"
  fi

  # Sistema
  temp=$(awk '{printf "%.0f", $1 / 1000}' /sys/class/thermal/thermal_zone0/temp 2>/dev/null)
  carico=$(cut -d' ' -f1 /proc/loadavg)
  ram=$(free | awk '/^Mem:/ {printf "%.0f", ($2 - $7) * 100 / $2}')
  sd=$(df / | awk 'NR == 2 {print $5}')
  acceso=$(awk '{s = int($1); g = int(s / 86400); h = int(s % 86400 / 3600); m = int(s % 3600 / 60);
    if (g) printf "%dg %dh", g, h; else printf "%dh %dm", h, m}' /proc/uptime)
  alim="${V}ok${N}"
  t=$(vcgencmd get_throttled 2>/dev/null | cut -d= -f2)
  if [ -n "$t" ]; then
    (( t & 0x1 )) && alim="${R}${B}SOTTOTENSIONE ORA${N}" || { (( t & 0x10000 )) && alim="${G}sottotensione passata${N}"; }
  fi
  tcol=$V; [ "${temp:-0}" -ge 70 ] && tcol=$G; [ "${temp:-0}" -ge 80 ] && tcol=$R

  # Si riaccende solo per i cambiamenti che contano; velocita', ora e temperatura no.
  ora="$in_rete ${ssid:+wifi} $disp"
  [ "$ora" != "$prima" ] && acceso_fino=$((SECONDS + SCHERMO_ACCESO_PER))
  prima=$ora
  if [ "$SCHERMO_ACCESO_PER" -gt 0 ] && [ $SECONDS -ge $acceso_fino ]; then
    [ $nero = 0 ] && printf '\e[0m\e[2J' > /dev/tty1
    nero=1
    continue
  fi
  nero=0

  {
    printf '\e[H'
    riga "${A}${B} PONTE WIFI${N}                   $(date '+%d/%m %H:%M')"
    riga "${A}------------------------------------------------${N}"
    riga " Internet  $inet"
    riga " WiFi      $wifi"
    riga " IP        ${ipwan:--}"
    riga " Download  ${B}$giu${N}"
    riga " Upload    ${B}$su${N}"
    riga " Totale    down $(quanti $rx1)  up $(quanti $tx1)"
    riga "${A}------------------------------------------------${N}"
    parola=dispositivi; [ "$disp" = 1 ] && parola=dispositivo
    riga " Switch    ${B}$disp $parola${N}  $lan"
    riga " LAN       10.42.0.1"
    riga "${A}------------------------------------------------${N}"
    riga " CPU       ${tcol}${temp} C${N}  carico $carico"
    riga " Memoria   RAM ${ram}%  SD ${sd}"
    riga " Acceso da $acceso"
    printf ' Alimentaz %s\e[K' "$alim"
  } > /dev/tty1
done
